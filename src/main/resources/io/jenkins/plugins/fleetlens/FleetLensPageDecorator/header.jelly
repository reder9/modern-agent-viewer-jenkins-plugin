<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core">
    <j:if test="${it.isComputerPage()}">
        <script src="${resURL}/plugin/modern-agent-viewer/js/fleetlens-banner.js" defer="defer" data-root-url="${rootURL}" data-redirect="${it.shouldRedirect()}"></script>
    </j:if>
    <j:if test="${it.isIndividualComputerPage()}">
        <j:if test="${it.isModernizeComputerPages()}">
            <link rel="stylesheet" href="${resURL}/plugin/modern-agent-viewer/css/fleetlens.css" type="text/css" />
            <script src="${resURL}/plugin/modern-agent-viewer/js/fleetlens-node.js" type="text/javascript" data-agent-name="${it.getCurrentComputerName()}" data-root-url="${rootURL}"></script>
        </j:if>
    </j:if>
</j:jelly>
